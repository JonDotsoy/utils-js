{
  "name": "@jondotsoy/utils-js",
  "description": "Some utilities to js",
  "version": "1.0.2",
  "module": "./libs/esm/index.js",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=16.4.1"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./libs/types/*"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./libs/esm/index.js",
      "types": "./libs/types/index.d.ts"
    },
    "./bytes": {
      "import": "./libs/esm/bytes/bytes.js",
      "types": "./libs/types/bytes/bytes.d.ts"
    },
    "./bytes-format": {
      "import": "./libs/esm/bytes-format/bytes-format.js",
      "types": "./libs/types/bytes-format/bytes-format.d.ts"
    },
    "./cleanuptasks": {
      "import": "./libs/esm/cleanuptasks/cleanuptasks.js",
      "types": "./libs/types/cleanuptasks/cleanuptasks.d.ts"
    },
    "./get": {
      "import": "./libs/esm/get/get.js",
      "types": "./libs/types/get/get.d.ts"
    },
    "./pipe": {
      "import": "./libs/esm/pipe/pipe.js",
      "types": "./libs/types/pipe/pipe.d.ts"
    },
    "./queue": {
      "import": "./libs/esm/queue/queue.js",
      "types": "./libs/types/queue/queue.d.ts"
    },
    "./result": {
      "import": "./libs/esm/result/result.js",
      "types": "./libs/types/result/result.d.ts"
    },
    "./set": {
      "import": "./libs/esm/set/set.js",
      "types": "./libs/types/set/set.d.ts"
    },
    "./visit": {
      "import": "./libs/esm/visit/visit.js",
      "types": "./libs/types/visit/visit.d.ts"
    },
    "./queue/store/indexeddb-store": {
      "import": "./libs/esm/queue/store/indexeddb-store.js",
      "types": "./libs/esm/queue/store/indexeddb-store.d.ts"
    },
    "./queue/store/worker-store": {
      "import": "./libs/esm/queue/store/worker-store.js",
      "types": "./libs/types/queue/store/worker-store.d.ts"
    },
    "./queue/store/worker-store-be": {
      "import": "./libs/esm/queue/store/worker-store-be.js",
      "types": "./libs/types/queue/store/worker-store-be.d.ts"
    },
    "./workspace": {
      "import": "./libs/esm/workspace/workspace.js",
      "types": "./libs/types/workspace/workspace.d.ts"
    },
    "./meter": {
      "import": "./libs/esm/meter/meter.js",
      "types": "./libs/types/meter/meter.d.ts"
    },
    "./pick": {
      "import": "./libs/esm/pick/pick.js",
      "types": "./libs/types/pick/pick.d.ts"
    }
  },
  "devDependencies": {
    "@types/bun": "1.2.22",
    "expect-type": "^1.2.1",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.3.3",
    "zod": "^3.25.51"
  },
  "peerDependencies": {
    "typescript": "5.9.2"
  },
  "scripts": {
    "fmt": "prettier -w .",
    "prepack": "make build"
  },
  "files": [
    "libs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonDotsoy/utils-js.git"
  },
  "keywords": [
    "get",
    "set",
    "visit",
    "pipe"
  ],
  "dependencies": {
    "@jondotsoy/shell": "1.2.0"
  }
}
